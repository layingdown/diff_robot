<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diff_robot_planner_cpp</name>
  <version>0.1.0</version>
  <description>
    A* 全局规划核心算法的 C++ 实现（astar_core，纯标准库，独立于 ROS2），
    以及把它包装成 nav2_core::GlobalPlanner 插件的 AStarPlanner，
    用于和 diff_robot_navigation 里的 Python 版本做多语言对照/性能对比
    （需求4）。astar_core 部分可以脱离 ROS2 单独编译，见 benchmark/。
  </description>
  <maintainer email="wei@todo.todo">wei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/diff_robot_planner_cpp_plugin.xml" />
  </export>
</package>
