<?xml version="1.0"?>
<!-- 
  ============================================================
  filename: diff_robot.urdf.xacro
  function: diff_robot URDF discription
  parameter: 轮距(L) = 0.30m, 轮半径(r) = 0.05m
  ============================================================
-->

<!-- ============================================================= -->
  <!-- 1. 建模参数    -->
  <!-- ============================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_robot">

  <xacro:property name="base_width"   value="0.30" />   <!-- 轮距 L (m)  
-->
  <xacro:property name="wheel_radius" value="0.05" />   <!-- 轮半径 r (m) 
-->
  <xacro:property name="base_length"  value="0.25" />   <!-- 底盘长 (m)                    -->
  <xacro:property name="base_height"  value="0.08" />   <!-- 底盘高 (m)                    -->
  <xacro:property name="wheel_width"  value="0.03" />   <!-- 轮宽 (m)                      -->
  <xacro:property name="caster_radius" value="0.015" /> <!-- 万向轮半径 (m)                -->

  <!-- ============================================================= -->
  <!-- 2. 材质定义（仅用于可视化）                      -->
  <!-- ============================================================= -->
  <material name="base_color">
    <color rgba="0.2 0.5 0.9 1.0"/>   <!-- 亮蓝色底盘 -->
  </material>
  <material name="wheel_color">
    <color rgba="0.1 0.1 0.1 1.0"/>   <!-- 黑色车轮 -->
  </material>
  <material name="caster_color">
    <color rgba="0.8 0.2 0.2 1.0"/>   <!-- 红色万向轮 -->
  </material>
  <material name="sensor_color">
    <color rgba="0.9 0.7 0.1 1.0"/>   <!-- 金色传感器 -->
  </material>

  <!-- ============================================================= -->
  <!-- 3. base_link                                              -->
  <!--    inertial parameter: mass = 1.0kg, uniform cuboid       -->
  <!-- ============================================================= -->
<link name="base_link">
  <visual>
    <geometry>
      <box size="${base_length} ${base_width} ${base_height}"/>
    </geometry>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    <material name="base_color"/>
  </visual>
  <collision>
    <geometry>
      <box size="${base_length} ${base_width} ${base_height}"/>
    </geometry>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </collision>
  <inertial>
    <mass value="1.0"/>
    <inertia ixx="0.01" ixy="0.0" ixz="0.0"
             iyy="0.01" iyz="0.0"
             izz="0.02"/>
  </inertial>
</link>

  <!-- ============================================================= -->
  <!-- 4. left_wheel_link                                         -->
  <!--    车轮是圆柱体，绕 Y 轴旋转                                  -->
  <!-- ============================================================= -->
  <link name="left_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>
 <!--加摩擦力-->
  <gazebo reference="left_wheel_link">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <material>Gazebo/Black</material>
</gazebo>

  <!-- 左轮关节: 连续旋转 (continuous)，绕 Y 轴旋转                   -->
  <!-- 位置: 底盘左侧 (x=0, y=+base_width/2, z=-wheel_radius)       -->
  <!--        z 向下偏移使得车轮底部刚好接触地面                     -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${base_width/2} ${-wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>   <!-- 绕 Y 轴旋转 -->
    <limit effort="50" velocity="20"/>
  </joint>

  <!-- ============================================================= -->
  <!-- 5. 右轮 (right_wheel_link) - 完全对称                         -->
  <!-- ============================================================= -->
  <link name="right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>
  
   <!--加摩擦力-->
<gazebo reference="right_wheel_link">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <material>Gazebo/Black</material>
</gazebo>

  <!-- 右轮关节: 位置在底盘右侧 (x=0, y=-base_width/2, z=-wheel_radius) -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-base_width/2} ${-wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
  </joint>

  <!-- ============================================================= -->
  <!-- 6. 万向轮 (前后各一个，支撑平衡，无动力)                    -->
  <!--    使用固定关节 (fixed)，因为不需要主动旋转建模               -->
  <!-- ============================================================= -->
  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="caster_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="${base_length/2 + 0.02} 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="caster_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="${-base_length/2 - 0.02} 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- 7. 激光雷达 (laser_link) - 安装在底盘顶部                    -->
  <!-- ============================================================= -->
  <link name="laser_link">
    <!-- 注意：visual 的 origin z 故意写成 -0.01（半个圆柱高度），让
         外壳整体"挂"在 laser_joint 原点下方、上表面正好贴着原点，
         而不是像最初那样以原点为中心上下各伸出一半。
         原因（上一次的判断是错的，这里更正）：gz-sim 的 GPU 雷达
         （GpuLidarSensor）底层是靠 Ogre2 渲染场景做深度检测的，它
         "看到"的是 <visual> 渲染出来的网格，不是物理引擎的
         <collision> 碰撞体——上一版只删掉 <collision> 完全没用，
         因为雷达根本没拿它判断遮挡。真正挡住雷达自己的，是这个
         <visual> 外壳本身：外壳以传感器射线原点为中心上下各伸出
         0.01m，射线发出点正好在这个实体网格内部，导致雷达一直
         "看见"自己的外壳，报出一个刚性焊在机器人身上、随它一起移
         动的假障碍物，实测确实把它画进了 SLAM 地图，沿着机器人走
         过的路径到处留下斜线痕迹，污染建图结果。现在把外壳挪到射
         线原点正下方（不再包住原点），射线就不会一出来就扎进自己
         的外壳里了。不再单独保留 <collision>：这种小传感器外壳没
         必要有自己的碰撞体，结构碰撞已经由主底盘的 collision box
         承担。 -->
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <material name="sensor_color"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>
<gazebo reference="laser_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>


  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 ${base_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- 8. IMU (imu_link) - 惯性测量单元                             -->
  <!-- ============================================================= -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="sensor_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>
<gazebo reference="imu_joint">
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>
  <!-- ============================================================= -->
  <!-- 9. Gazebo 插件                                            -->
  <!--    - 差速驱动插件：订阅 /cmd_vel，控制车轮转动，发布里程计    -->
  <!--    - 激光雷达插件：发布 /scan 话题                           -->
  <!--    - IMU 插件：发布 /imu/data 话题                          -->
  <!-- ============================================================= -->

  <!-- 9-a: Gazebo 差速驱动插件 -->
  <!-- 
    这个插件做三件事:
    1. 订阅 /cmd_vel 话题，接收线速度和角速度指令
    2. 根据轮距 L 和轮半径 r 将 v/ω 转换为左右轮速度
    3. 驱动左右轮转动，并发布 /odom 里程计话题
  -->
<gazebo>
<plugin name="gz::sim::systems::DiffDrive" filename="libgz-sim-diff-drive-system.so">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>${base_width}</wheel_separation>
    <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
    <max_wheel_torque>50</max_wheel_torque>
    <max_wheel_acceleration>5.0</max_wheel_acceleration>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <!-- 注意：gz-sim 的 DiffDrive 插件实际认的参数名是 frame_id /
         child_frame_id，不是 odom_frame / robot_base_frame（那是老
         gazebo_ros_diff_drive 插件的参数名，抄错了）。用错参数名的
         后果是这两个标签被静默忽略，插件退回默认值，给 odom 话题的
         frame_id/child_frame_id 自动加上机器人名字前缀，变成
         "diff_robot/odom"/"diff_robot/base_link"，跟 ekf.yaml 里配置
         的 "odom"/"base_link" 对不上，导致 EKF 找不到对应的 TF、把
         位置观测整个丢掉——表现为 /odometry/filtered 的 position 永
         远卡在 (0,0,0)、协方差越滚越大，进而导致 SLAM 建图整个乱掉
         （所有帧都被当成在同一个点、只是朝向不同，地图变成放射状）。
         这里改成正确的参数名，让 /odom 直接发布成 "odom"/"base_link"，
         和系统里其它地方保持一致。 -->
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
  </plugin>
</gazebo>
<!-- 反馈轮子角度给/joint_states -->
<gazebo>
  <plugin filename="libgz-sim-joint-state-publisher-system.so"
          name="gz::sim::systems::JointStatePublisher">
    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>
  </plugin>
</gazebo>
<!-- 9-b: Gazebo 激光雷达插件 -->
<!-- 注意：必须用 "gpu_lidar"，不能用 "lidar"（CPU 版）。
     实测过：这台机器的 Gazebo Sim v8.11.0 根本不支持 "lidar" 这个类型，
     日志会报 "Sensor type LIDAR not supported yet. Try using a GPU LIDAR
     instead."，传感器实体压根不会被创建，/scan 话题永远不会发布。
     gpu_lidar 依赖 gz-rendering（Ogre2），这台机器只有纯软件的 llvmpipe
     渲染（新硬件跟 Ubuntu 显卡驱动不兼容，只能 acpi=off 启动，去掉这个
     内核参数会黑屏进不了系统，这是无法修复的硬件限制），Ogre2 在
     llvmpipe 上初始化会比较慢，但仍然能跑，只是要有耐心等它初始化完，
     不要在传感器还没就绪时就以为卡死而 Ctrl+C 打断。真正拖慢这台机器的
     主要是 gz_gui 那个独立 3D 渲染窗口，已经在 gazebo.launch.py 里默认
     关掉了；gpu_lidar 本身没有替代方案，这是当前 Gazebo 版本唯一支持的
     雷达类型。 -->
<gazebo reference="laser_link">
  <sensor type="gpu_lidar" name="laser">
    <pose>0 0 0 0 0 0</pose>
    <visualize>true</visualize>
    <update_rate>10</update_rate>
    <topic>scan</topic>
    <gz_frame_id>laser_link</gz_frame_id>
    <lidar>
      <scan>
        <horizontal>
         <samples>360</samples>
         <resolution>1</resolution>
         <min_angle>-3.14</min_angle>
        <max_angle>3.14</max_angle>
       </horizontal>
       <vertical>
         <samples>1</samples>
         <resolution>1</resolution>
         <min_angle>0</min_angle>
         <max_angle>0</max_angle>
       </vertical>
  </scan>
  <range>
    <min>0.1</min>
    <max>10.0</max>
    <resolution>0.01</resolution>
  </range>
  <noise>
    <type>gaussian</type>
    <mean>0.0</mean>
    <stddev>0.02</stddev>
  </noise>
</lidar>
  </sensor>
</gazebo>

  <!-- 9-c: Gazebo IMU 插件 -->
<gazebo reference="imu_link">
  <sensor type="imu" name="imu_sensor">
  <pose>0 0 0 0 0 0</pose>
  <visualize>false</visualize>
  <update_rate>50</update_rate>
  <topic>imu/data</topic>
  <gz_frame_id>imu_link</gz_frame_id>
  <imu>
    <angular_velocity>
      <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
      <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
      <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
    </angular_velocity>
    <linear_acceleration>
      <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
      <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
      <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
    </linear_acceleration>
  </imu>
</sensor>
</gazebo>
</robot>
<!-- ========== 文件结束 ========== -->
